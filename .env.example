# ==============================================================================
# WanderWay v3.0 — Environment Configuration Template
# Copy this file to .env.local or .env and fill in your keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database, Auth, Storage, Realtime)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=your_db_password

# ------------------------------------------------------------------------------
# 3. AI PLANNING ENGINE (LLMs)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# ------------------------------------------------------------------------------
# 4. LOCATION, MAPS & ROUTING
# ------------------------------------------------------------------------------
GEOAPIFY_API_KEY=your_geoapify_api_key
NEXT_PUBLIC_GEOAPIFY_API_KEY=your_geoapify_api_key

# ------------------------------------------------------------------------------
# 5. WEATHER & SEVERE WEATHER WARNINGS (PRD §5.8 & §5.15C)
# ------------------------------------------------------------------------------
# OPENWEATHER_API_KEY=your_openweather_api_key
# WEATHER_API_KEY=your_weatherapi_key

# ------------------------------------------------------------------------------
# 6. TRAVEL INTELLIGENCE & NEWS (PRD §5.15A & §5.15B)
# ------------------------------------------------------------------------------
# NEWS_API_KEY=your_news_api_key

# ------------------------------------------------------------------------------
# 7. CURRENCY CONVERSION & FINANCIALS (PRD §5.7)
# ------------------------------------------------------------------------------
# EXCHANGE_RATE_API_KEY=your_exchange_rate_key

